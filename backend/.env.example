# PostgreSQL
DATABASE_URL=postgresql://steel_user:steel_pass@localhost:5432/steel_quality

# Gemini API (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# MLflow
MLFLOW_TRACKING_URI=./mlruns

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SENSOR_TOPIC=steel.sensor.readings
KAFKA_CONSUMER_GROUP=steel-quality-api

# Alert thresholds
DEFECT_PROBABILITY_ALERT_THRESHOLD=0.65
CRITICAL_DEFECT_PROBABILITY_THRESHOLD=0.85
